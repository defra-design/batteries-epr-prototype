{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <p class="govuk-body">{{ labels.intro }}</p>

      <h2 class="govuk-heading-s">{{ labels.responsibilitiesHeading }}</h2>
      <p class="govuk-body">{{ labels.responsibilitiesIntro }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for bullet in labels.responsibilitiesBullets %}
          <li>{{ bullet }}</li>
        {% endfor %}
      </ul>

      <h2 class="govuk-heading-s">{{ labels.whoHeading }}</h2>
      {% set tableRows = [] %}
      {% for row in labels.whoRows %}
        {% set tableRows = (tableRows.push([{ text: row.organisation }, { text: row.role }]), tableRows) %}
      {% endfor %}
      {{ govukTable({
        head: [
          { text: labels.whoColumnOrganisation },
          { text: labels.whoColumnRole }
        ],
        rows: tableRows,
        attributes: { "data-testid": "appropriate-person-roles-table" }
      }) }}

      <h2 class="govuk-heading-s">{{ labels.delegateHeading }}</h2>
      <p class="govuk-body">{{ labels.delegateBody }}</p>

      {{ govukButton({
        text: labels.continueAction,
        href: continueUrl,
        attributes: { "data-testid": "appropriate-person-guidance-continue" }
      }) }}
    </div>
  </div>
{% endblock %}
