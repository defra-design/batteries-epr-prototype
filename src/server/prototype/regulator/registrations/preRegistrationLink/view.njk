{% extends 'layouts/regulator.njk' %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary and errorSummary.length %}
        {{
          govukErrorSummary({
            titleText: errorTitle,
            errorList: errorSummary,
            attributes: { "data-testid": "pre-registration-link-error-summary" }
          })
        }}
      {% endif %}

      <form
        method="post"
        action="{{ action }}"
        novalidate
        data-testid="pre-registration-link-form"
      >
        {{
          govukInput({
            id: "name",
            name: "name",
            autocomplete: "off",
            label: { text: labels.nameLabel, classes: "govuk-label--s" },
            value: formValues.name,
            errorMessage: { text: errors.name } if errors.name,
            attributes: { "data-testid": "pre-registration-link-name" }
          })
        }}

        {{
          govukInput({
            id: "email",
            name: "email",
            type: "email",
            autocomplete: "off",
            spellcheck: false,
            label: { text: labels.emailLabel, classes: "govuk-label--s" },
            value: formValues.email,
            errorMessage: { text: errors.email } if errors.email,
            attributes: { "data-testid": "pre-registration-link-email" }
          })
        }}

        {{
          govukButton({
            text: labels.submitAction,
            preventDoubleClick: true,
            attributes: { "data-testid": "pre-registration-link-submit" }
          })
        }}
      </form>
    </div>
  </div>
{% endblock %}
