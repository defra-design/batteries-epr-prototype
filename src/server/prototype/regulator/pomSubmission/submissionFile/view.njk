{% extends 'layouts/regulator.njk' %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ govukSummaryList({ rows: summaryRows, attributes: { "data-testid": "submission-file-summary" } }) }}

  <h2 class="govuk-heading-l">{{ labels.flaggedHeading }}</h2>
  {%- set rows = [] -%}
  {%- for flagged in flaggedRows -%}
    {%- set actionsHtml -%}
      <a class="govuk-link" href="#">{{ labels.query }}<span class="govuk-visually-hidden"> row {{ flagged.row }}</span></a>
      <span aria-hidden="true">·</span>
      <a class="govuk-link" href="#">{{ labels.reject }}<span class="govuk-visually-hidden"> row {{ flagged.row }}</span></a>
    {%- endset -%}
    {%- set rows = (rows.push([
      { text: flagged.row },
      { text: flagged.chemistry },
      { text: flagged.category },
      { text: flagged.figure },
      { html: govukTag({ text: flagged.check, classes: "govuk-tag--orange" }) },
      { html: actionsHtml }
    ]), rows) -%}
  {%- endfor -%}
  {{ govukTable({
    head: [
      { text: labels.columns.row },
      { text: labels.columns.chemistry },
      { text: labels.columns.category },
      { text: labels.columns.figure },
      { text: labels.columns.check },
      { text: labels.columns.action }
    ],
    rows: rows,
    attributes: { "data-testid": "submission-file-flagged-rows" }
  }) }}

  <ul class="govuk-list">
    <li><a class="govuk-link" href="#" data-testid="submission-file-view-all-rows">{{ viewAllRowsText }}</a></li>
    <li><a class="govuk-link" href="#" data-testid="submission-file-download">{{ labels.download }}</a></li>
  </ul>

  {{ govukButton({ text: labels.backToFiles, href: backToFilesHref, attributes: { "data-testid": "submission-file-back-to-files" } }) }}
{% endblock %}
