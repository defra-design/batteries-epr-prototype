{% extends 'layouts/regulator.njk' %}
{% from "prototypeRegulator/macros.njk" import quickLinks %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ quickLinks(labels.quickLinks.label, quickLinkItems, "pom-dashboard-quick-links") }}

  <h2 class="govuk-heading-m">{{ labels.year.heading }}</h2>
  <form method="get" action="{{ action }}" data-testid="pom-dashboard-year-form">
    {{
      govukSelect({
        id: "year",
        name: "year",
        label: { text: labels.year.label, classes: "govuk-visually-hidden" },
        hint: { text: labels.year.hint },
        items: years,
        attributes: { "data-testid": "pom-dashboard-year" }
      })
    }}
    {{ govukButton({ text: labels.year.action, classes: "govuk-button--secondary", attributes: { "data-testid": "pom-dashboard-year-submit" } }) }}
  </form>

  <h2 class="govuk-heading-m">{{ tasksHeading }}</h2>
  <div class="app-regulator-task-cards" data-testid="pom-dashboard-task-cards">
    {% for card in taskCards %}
      <div class="app-task-card" data-testid="pom-dashboard-card-{{ card.key }}">
        <p class="govuk-body-s app-task-card__label">{{ card.label }}</p>
        <p class="govuk-heading-xl app-task-card__count">{{ card.count }}</p>
        {% if card.link %}<a class="govuk-link" href="{{ card.href }}">{{ card.link }}</a>{% endif %}
      </div>
    {% endfor %}
  </div>

  {%- set tabItems = [] -%}
  {%- for tab in tabs -%}
    {%- set rows = [] -%}
    {%- for entry in tab.returns -%}
      {%- set schemeHtml -%}
        <a class="govuk-link" href="{{ entry.viewHref }}" data-testid="pom-dashboard-scheme-{{ entry.schemeId }}">{{ entry.schemeName }}</a>
      {%- endset -%}
      {%- set viewHtml -%}
        <a class="govuk-link" href="{{ entry.viewHref }}" data-testid="pom-dashboard-view-{{ entry.schemeId }}">{{ labels.viewAction }}<span class="govuk-visually-hidden"> {{ entry.schemeName }}</span></a>
      {%- endset -%}
      {%- set rows = (rows.push([
        { html: schemeHtml },
        { text: entry.membersCount if entry.membersCount != null else "–" },
        { text: (entry.submittedOn | formatDate('d MMMM yyyy')) if entry.submittedOn else "–" },
        { html: govukTag({ text: entry.statusLabel, classes: "govuk-tag--" + entry.statusColour }) },
        { text: entry.flags if entry.flags != null else "–" },
        { html: viewHtml }
      ]), rows) -%}
    {%- endfor -%}
    {%- set submittedHeadHtml -%}
      <a class="govuk-link govuk-link--no-visited-state" href="{{ headings.submitted.href }}">{{ headings.submitted.text }}</a>
    {%- endset -%}
    {%- set statusHeadHtml -%}
      <a class="govuk-link govuk-link--no-visited-state" href="{{ headings.status.href }}">{{ headings.status.text }}</a>
    {%- endset -%}
    {%- set panelHtml -%}
      <h2 class="govuk-heading-l">{{ returnsHeading }}</h2>
      <p class="govuk-body">{{ labels.returnsIntro }}</p>
      {% if rows.length %}
        {{
          govukTable({
            head: [
              { text: labels.columns.scheme },
              { text: labels.columns.members },
              { html: submittedHeadHtml, attributes: { "aria-sort": headings.submitted.ariaSort } },
              { html: statusHeadHtml, attributes: { "aria-sort": headings.status.ariaSort } },
              { text: labels.columns.flags },
              { html: '<span class="govuk-visually-hidden">Action</span>' }
            ],
            rows: rows,
            attributes: { "data-testid": "pom-dashboard-table-" + tab.key }
          })
        }}
      {% else %}
        <p class="govuk-body" data-testid="pom-dashboard-empty">{{ noReturns }}</p>
      {% endif %}
    {%- endset -%}
    {%-
      set tabItems = (tabItems.push({
        label: tab.label + " (" + tab.returns.length + ")",
        id: "pom-" + tab.key,
        panel: { html: panelHtml }
      }), tabItems)
    -%}
  {%- endfor -%}

  {{ govukTabs({ idPrefix: "pom", items: tabItems, attributes: { "data-testid": "pom-dashboard-tabs" } }) }}
{% endblock %}
