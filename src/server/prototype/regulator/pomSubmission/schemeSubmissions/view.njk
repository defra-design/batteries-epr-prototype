{% extends 'layouts/regulator.njk' %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block content %}
  <p class="govuk-body">{{ summary }}</p>

  {% for yearGroup in years %}
    <h2 class="govuk-heading-l">{{ yearGroup.year }}</h2>

    {% set submissionRows = [] %}
    {% for submission in yearGroup.submissions %}
      {% set viewCellHtml %}
        <a class="govuk-link" href="#" data-testid="scheme-submissions-view-{{ submission.id }}">{{ labels.viewAction }}<span class="govuk-visually-hidden"> {{ submission.periodLabel }}</span></a>
      {% endset %}
      {% set submissionRows = (submissionRows.push([
        { text: submission.periodLabel },
        { text: (submission.submittedOn | formatDate('d MMMM yyyy')) if submission.submittedOn else "–" },
        { text: submission.filesCount },
        { html: govukTag({ text: submission.statusLabel, classes: "govuk-tag--" + submission.statusColour }) },
        { text: submission.decided },
        { html: viewCellHtml }
      ]), submissionRows) %}
    {% endfor %}

    {{ govukTable({
      head: [
        { text: labels.columns.quarter },
        { text: labels.columns.submitted },
        { text: labels.columns.files },
        { text: labels.columns.decision },
        { text: labels.columns.decided },
        { html: '<span class="govuk-visually-hidden">Action</span>' }
      ],
      rows: submissionRows,
      attributes: { "data-testid": "scheme-submissions-table-" + yearGroup.year }
    }) }}
  {% endfor %}

  <h2 class="govuk-heading-m">{{ labels.windows.heading }}</h2>
  <p class="govuk-hint">{{ labels.windows.hint }}</p>
  {% set windowRows = [] %}
  {% for window in windows %}
    {% set windowRows = (windowRows.push([
      { text: window.period, classes: "govuk-!-font-weight-bold" },
      { text: window.description },
      { html: govukTag({ text: window.tag.text, classes: "govuk-tag--" + window.tag.colour }) }
    ]), windowRows) %}
  {% endfor %}
  {{ govukTable({
    firstCellIsHeader: true,
    caption: labels.windows.heading,
    captionClasses: "govuk-visually-hidden",
    rows: windowRows,
    attributes: { "data-testid": "scheme-submissions-windows" }
  }) }}

  <ul class="govuk-list">
    <li><a class="govuk-link" href="#" data-testid="scheme-submissions-download">{{ labels.downloadLink }}</a></li>
    <li><a class="govuk-link" href="#" data-testid="scheme-submissions-history">{{ labels.historyLink }}</a></li>
    <li><a class="govuk-link" href="{{ homeLink.href }}" data-testid="scheme-submissions-home-link">{{ homeLink.text }}</a></li>
  </ul>
{% endblock %}
