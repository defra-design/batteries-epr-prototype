{% extends 'layouts/regulator.njk' %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/task-list/macro.njk" import govukTaskList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <h2 class="govuk-heading-l">{{ labels.detailsHeading }}</h2>
  {{ govukSummaryList({ rows: detailRows, attributes: { "data-testid": "scheme-home-details" } }) }}

  <ul class="govuk-list app-regulator-inline-links" data-testid="scheme-home-quick-links">
    {% for link in quickLinks %}
      <li><a class="govuk-link" href="{{ link.href }}" data-testid="scheme-home-quick-link-{{ link.key }}">{{ link.text }}</a></li>
    {% endfor %}
  </ul>

  <h2 class="govuk-heading-l" data-testid="scheme-home-submission-heading">{{ submissionHeading }}</h2>
  <p class="govuk-body" data-testid="scheme-home-submission-intro">{{ section.intro }}</p>

  {% if section.deadline %}
    <p class="govuk-body">
      {{ govukTag({ text: status.text, classes: "govuk-tag--" + status.colour }) }}
      <span data-testid="scheme-home-deadline">{{ section.deadline }}</span>
    </p>
  {% endif %}

  {% if section.taskList %}
    <h2 class="govuk-heading-l">{{ section.taskList.heading }}</h2>
    {{ govukTaskList({ items: section.taskList.items, attributes: { "data-testid": "scheme-home-task-list" } }) }}
  {% endif %}

  {{ govukSummaryList({ rows: section.summaryRows, attributes: { "data-testid": "scheme-home-submission-summary" } }) }}

  <p class="govuk-body">
    {{ labels.statusLabel }}
    {{ govukTag({ text: status.text, classes: "govuk-tag--" + status.colour, attributes: { "data-testid": "scheme-home-status" } }) }}
  </p>

  <ul class="govuk-list" data-testid="scheme-home-links">
    {% for link in section.links %}
      <li><a class="govuk-link" href="{{ link.href }}">{{ link.text }}</a></li>
    {% endfor %}
  </ul>

  {% if section.button %}
    {{ govukButton({ text: section.button.text, href: section.button.href, attributes: { "data-testid": "scheme-home-primary-action" } }) }}
  {% endif %}
{% endblock %}
