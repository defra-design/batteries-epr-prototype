{% extends 'layouts/regulator.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% block hero %}
  {{ govukBackLink({ text: backLink.text, href: backLink.href, classes: "app-regulator-back-link", attributes: { "data-testid": "back-link" } }) }}
  <h1 class="govuk-heading-xl app-regulator-hero__heading">
    {{- heading }} {{ govukTag({ text: tag.text, classes: "govuk-tag--" + tag.colour + " app-regulator-hero__tag", attributes: { "data-testid": "heading-tag" } }) -}}
  </h1>
  <p class="govuk-body-l app-regulator-hero__intro app-regulator-hero__subtitle" data-testid="submission-files-subtitle">{{ subtitle }}</p>
  <p class="govuk-body">{{ intro }}</p>
{% endblock %}

{% block content %}
  {{ govukSummaryList({ rows: summaryRows, attributes: { "data-testid": "submission-files-summary" } }) }}

  <h2 class="govuk-heading-l">{{ labels.dataFilesHeading }}</h2>
  {%- set fileRows = [] -%}
  {%- for file in files -%}
    {%- set actionsHtml -%}
      <a class="govuk-link" href="{{ file.openHref }}" data-testid="submission-files-open-{{ file.id }}">{{ labels.open }}<span class="govuk-visually-hidden"> {{ file.fileName }}</span></a><br>
      <a class="govuk-link" href="#">{{ labels.download }}<span class="govuk-visually-hidden"> {{ file.fileName }}</span></a>
    {%- endset -%}
    {%- set fileRows = (fileRows.push([
      { text: file.fileName },
      { text: file.members },
      { text: file.records },
      { text: file.total },
      { text: file.uploadedShort },
      { html: govukTag({ text: file.check.text, classes: "govuk-tag--" + file.check.colour }) },
      { html: actionsHtml }
    ]), fileRows) -%}
  {%- endfor -%}
  {{ govukTable({
    head: [
      { text: labels.columns.file },
      { text: labels.columns.members },
      { text: labels.columns.records },
      { text: labels.columns.total },
      { text: labels.columns.uploaded },
      { text: labels.columns.checks },
      { text: labels.columns.action }
    ],
    rows: fileRows,
    attributes: { "data-testid": "submission-files-table" }
  }) }}

  <h2 class="govuk-heading-l">{{ labels.evidenceHeading }}</h2>
  {%- set evidenceRows = [] -%}
  {%- for doc in evidence -%}
    {%- set evidenceActions -%}
      <a class="govuk-link" href="#">{{ labels.openBeside }}<span class="govuk-visually-hidden"> {{ doc.fileName }}</span></a><br>
      <a class="govuk-link" href="#">{{ labels.download }}<span class="govuk-visually-hidden"> {{ doc.fileName }}</span></a>
    {%- endset -%}
    {%- set evidenceRows = (evidenceRows.push([
      { text: doc.fileName },
      { text: doc.covers },
      { text: doc.uploadedShort },
      { html: evidenceActions }
    ]), evidenceRows) -%}
  {%- endfor -%}
  {{ govukTable({
    head: [
      { text: labels.evidenceColumns.document },
      { text: labels.evidenceColumns.covers },
      { text: labels.evidenceColumns.uploaded },
      { text: labels.evidenceColumns.action }
    ],
    rows: evidenceRows,
    attributes: { "data-testid": "submission-files-evidence" }
  }) }}

  {{ govukInsetText({ text: labels.inset }) }}

  <ul class="govuk-list app-regulator-inline-links">
    <li><a class="govuk-link" href="#" data-testid="submission-files-history">{{ labels.historyLink }}</a></li>
    <li><a class="govuk-link" href="{{ reviewHref }}" data-testid="submission-files-review">{{ labels.reviewLink }}</a></li>
  </ul>
{% endblock %}
