{% extends 'layouts/page.njk' %}

{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="govuk-!-margin-bottom-4">
        <span class="govuk-heading-xl govuk-!-margin-bottom-0 govuk-!-display-inline-block govuk-!-margin-right-3" data-testid="submission-files-heading">{{ heading }}</span>
        {{ govukTag({ text: labels.checksCompleteTag, classes: "govuk-tag--green", attributes: { "data-testid": "submission-files-status" } }) }}
      </div>
      <p class="govuk-body" data-testid="submission-files-intro">{{ intro }}</p>

      {{ govukSummaryList({
        rows: [
          { key: { text: labels.summaryLabels.period }, value: { text: periodLine } },
          { key: { text: labels.summaryLabels.filesUploaded }, value: { text: files.length } },
          { key: { text: labels.summaryLabels.membersCovered }, value: { text: membersCoveredLine } },
          { key: { text: labels.summaryLabels.totalPlaced }, value: { text: totalPlacedOnMarketLine } },
          { key: { text: labels.summaryLabels.submittedBy }, value: { text: submittedByLine } }
        ],
        attributes: { "data-testid": "submission-files-summary" }
      }) }}

      <h2 class="govuk-heading-l">{{ labels.filesHeading }}</h2>

      {% set fileRows = [] %}
      {% for file in files %}
        {% set openCellHtml %}
          <a class="govuk-link" href="{{ file.openHref }}" data-testid="submission-files-open-{{ loop.index }}">{{ labels.openLink }}</a>
        {% endset %}
        {% set fileRows = (fileRows.push([
          { text: file.fileName },
          { text: file.membersCovered },
          { text: file.rows },
          { text: file.uploadedOn },
          { html: govukTag({ text: file.checkStatusLabel, classes: "govuk-tag--" + file.checkStatusColour }) | safe },
          { html: openCellHtml }
        ]), fileRows) %}
      {% endfor %}

      {{ govukTable({
        head: [
          { text: labels.columns.fileName },
          { text: labels.columns.members },
          { text: labels.columns.rows },
          { text: labels.columns.uploaded },
          { text: labels.columns.checks },
          { text: labels.columns.action }
        ],
        rows: fileRows,
        attributes: { "data-testid": "submission-files-table" }
      }) }}

      <p class="govuk-body">{{ labels.footerNote }}</p>
      <p class="govuk-body">
        <a class="govuk-link" href="#" data-testid="submission-files-download-all">{{ downloadAllText }}</a>
      </p>

      {{ govukButton({
        text: labels.continueAction,
        href: continueHref,
        attributes: { "data-testid": "submission-files-continue" }
      }) }}
    </div>
  </div>
{% endblock %}
