{% extends 'layouts/regulator.njk' %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {% if errorSummary and errorSummary.length %}
    {{ govukErrorSummary({ titleText: labels.errorTitle, errorList: errorSummary, attributes: { "data-testid": "reject-error-summary" } }) }}
  {% endif %}

  {{ govukWarningText({ text: warning, iconFallbackText: "Warning", attributes: { "data-testid": "reject-warning" } }) }}

  <form method="post" action="{{ action }}" novalidate data-testid="reject-form">
    {{ govukRadios({
      idPrefix: "errorType",
      name: "errorType",
      fieldset: { legend: { text: labels.typeLegend, classes: "govuk-fieldset__legend--m" } },
      errorMessage: { text: errors.errorType } if errors.errorType,
      items: types
    }) }}

    {{ govukCharacterCount({
      id: "details",
      name: "details",
      maxlength: 1000,
      rows: 5,
      value: formValues.details,
      label: { text: labels.detailsLabel, classes: "govuk-label--m" },
      hint: { text: detailsHint },
      errorMessage: { text: errors.details } if errors.details,
      attributes: { "data-testid": "reject-details" }
    }) }}

    {{ govukDateInput({
      id: "respondBy",
      namePrefix: "respondBy",
      fieldset: { legend: { text: labels.resubmitLabel, classes: "govuk-fieldset__legend--m" } },
      hint: { text: labels.resubmitHint },
      errorMessage: { text: errors.respondBy } if errors.respondBy,
      items: [
        { name: "day", classes: "govuk-input--width-2" + (" govuk-input--error" if errors.respondBy), value: formValues["respondBy-day"] },
        { name: "month", classes: "govuk-input--width-2" + (" govuk-input--error" if errors.respondBy), value: formValues["respondBy-month"] },
        { name: "year", classes: "govuk-input--width-4" + (" govuk-input--error" if errors.respondBy), value: formValues["respondBy-year"] }
      ]
    }) }}
    {{ govukInput({
      id: "respondByTime",
      name: "respondByTime",
      classes: "govuk-input--width-5",
      label: { text: labels.timeLabel, classes: "govuk-label--s" },
      hint: { text: labels.timeHint },
      value: formValues.respondByTime,
      attributes: { "data-testid": "reject-time" }
    }) }}

    <div class="govuk-button-group">
      {{ govukButton({ text: labels.rejectAction, classes: "govuk-button--warning", preventDoubleClick: true, attributes: { "data-testid": "reject-confirm" } }) }}
      <a class="govuk-link" href="{{ cancelHref }}" data-testid="reject-cancel">{{ labels.cancelLink }}</a>
    </div>
  </form>
{% endblock %}
