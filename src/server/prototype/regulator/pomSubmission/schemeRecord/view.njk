{% extends 'layouts/regulator.njk' %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block content %}
  <p class="govuk-body" data-testid="scheme-record-reference">{{ reference }}</p>

  <h2 class="govuk-heading-l">{{ labels.organisationHeading }}</h2>
  {{ govukSummaryList({ rows: organisationRows, attributes: { "data-testid": "scheme-record-organisation" } }) }}

  <h2 class="govuk-heading-l">{{ labels.approvalHeading }}</h2>
  {{ govukSummaryList({ rows: approvalRows, attributes: { "data-testid": "scheme-record-approval" } }) }}

  <h2 class="govuk-heading-l">{{ labels.peopleHeading }}</h2>
  {{ govukSummaryList({ rows: peopleRows, attributes: { "data-testid": "scheme-record-people" } }) }}

  <h2 class="govuk-heading-l">{{ labels.documentsHeading }}</h2>
  <ul class="govuk-list" data-testid="scheme-record-documents">
    {% for link in documentLinks %}
      <li><a class="govuk-link" href="{{ link.href }}" data-testid="scheme-record-link-{{ link.key }}">{{ link.text }}</a></li>
    {% endfor %}
  </ul>

  <p class="govuk-body">
    <a class="govuk-link" href="{{ homeLink.href }}" data-testid="scheme-record-home-link">{{ homeLink.text }}</a>
  </p>
{% endblock %}
