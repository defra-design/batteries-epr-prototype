{% extends 'layouts/regulator.njk' %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block content %}
  <p class="govuk-body" data-testid="scheme-members-summary">{{ summary }}</p>

  {% set memberRows = [] %}
  {% for member in members %}
    {% set viewCellHtml %}
      <a class="govuk-link" href="#" data-testid="scheme-members-view-{{ member.bprn }}">{{ labels.viewAction }}<span class="govuk-visually-hidden"> {{ member.companyName }}</span></a>
    {% endset %}
    {% set memberRows = (memberRows.push([
      { text: member.companyName },
      { text: member.bprn },
      { text: member.joinedOn },
      { html: govukTag({ text: member.status.text, classes: "govuk-tag--" + member.status.colour }) },
      { html: viewCellHtml }
    ]), memberRows) %}
  {% endfor %}

  {{ govukTable({
    head: [
      { text: labels.columns.member },
      { text: labels.columns.bprn },
      { text: labels.columns.joined },
      { text: returnColumn },
      { html: '<span class="govuk-visually-hidden">Action</span>' }
    ],
    rows: memberRows,
    attributes: { "data-testid": "scheme-members-table" }
  }) }}

  <ul class="govuk-list">
    <li><a class="govuk-link" href="#" data-testid="scheme-members-download">{{ labels.downloadLink }}</a></li>
    <li><a class="govuk-link" href="{{ submissionsHref }}" data-testid="scheme-members-submissions-link">{{ labels.submissionsLink }}</a></li>
    <li><a class="govuk-link" href="{{ homeLink.href }}" data-testid="scheme-members-home-link">{{ homeLink.text }}</a></li>
  </ul>
{% endblock %}
