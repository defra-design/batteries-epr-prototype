{% extends 'layouts/page.njk' %}

{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ heading }}</h1>
      <p class="govuk-body" data-testid="data-check-report-intro">{{ intro }}</p>

      <h2 class="govuk-heading-l">{{ labels.findingsHeading }}</h2>
      <p class="govuk-body govuk-!-margin-bottom-4">{{ labels.findingsCaption }}</p>

      {% set findingRows = [] %}
      {% for finding in findings %}
        {% set findingRows = (findingRows.push([
          { text: finding.member },
          { text: finding.issue },
          { html: govukTag({ text: finding.typeLabel, classes: "govuk-tag--" + finding.typeColour }) | safe }
        ]), findingRows) %}
      {% endfor %}

      {{ govukTable({
        head: [
          { text: labels.columns.member },
          { text: labels.columns.issue },
          { text: labels.columns.type }
        ],
        rows: findingRows,
        attributes: { "data-testid": "data-check-report-findings-table" }
      }) }}

      <h2 class="govuk-heading-l">{{ labels.observationsHeading }}</h2>
      <p class="govuk-body">{{ labels.observationsIntro }}</p>

      {{ govukTextarea({
        id: "observations",
        name: "observations",
        label: { text: labels.observationsLabel, classes: "govuk-visually-hidden" },
        attributes: { "data-testid": "data-check-report-observations" }
      }) }}

      {{ govukButton({
        text: labels.continueAction,
        href: continueHref,
        attributes: { "data-testid": "data-check-report-continue" }
      }) }}
    </div>
  </div>
{% endblock %}
