{% extends 'layouts/page.njk' %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "prototypeRegulatorWasteReturns/macros.njk" import factsPanel %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl" data-testid="reclassified-heading">
        {{ heading }}
      </h1>

      {{ factsPanel(facts, "reclassified-facts") }}


      {%- set bannerHtml -%}
        <h3 class="govuk-notification-banner__heading">
          {{ labels.bannerHeading }}
        </h3>
        <p class="govuk-body">{{ bannerBody }}</p>
      {%- endset -%}
      {{
        govukNotificationBanner({
          type: "success",
          titleText: labels.bannerTitle,
          html: bannerHtml,
          attributes: { "data-testid": "reclassified-banner" }
        })
      }}

      {%- set rows = [] -%}
      {%- for row in summaryRows -%}
        {%- set rows = (rows.push({ key: { text: row.label }, value: { text: row.text } }), rows) -%}
      {%- endfor -%}
      {{
        govukSummaryList({
          rows: rows,
          classes: "govuk-summary-list--no-border",
          attributes: { "data-testid": "reclassified-summary" }
        })
      }}

      <h2 class="govuk-heading-m">{{ labels.nextHeading }}</h2>
      <p class="govuk-body">{{ nextBody }}</p>

      <p class="govuk-body">
        <a
          class="govuk-link"
          href="{{ flagsHref }}"
          data-testid="reclassified-back-to-flags"
          >{{ labels.backToFlags }}</a
        >
      </p>
      <p class="govuk-body">
        <a
          class="govuk-link"
          href="{{ accountHref }}"
          data-testid="reclassified-view-account"
          >{{ viewAccountLabel }}</a
        >
      </p>
    </div>
  </div>
{% endblock %}
