{% extends 'layouts/page.njk' %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl" data-testid="accept-heading">
        {{ heading }}
      </h1>

      {{
        govukWarningText({
          text: labels.warning,
          iconFallbackText: "Warning",
          attributes: { "data-testid": "accept-warning" }
        })
      }}

      {%- set rows = [] -%}
      {%- for row in summaryRows -%}
        {%- set rows = (rows.push({ key: { text: row.label }, value: { text: row.text } }), rows) -%}
      {%- endfor -%}
      {{
        govukSummaryList({
          rows: rows,
          classes: "govuk-summary-list--no-border",
          attributes: { "data-testid": "accept-summary" }
        })
      }}

      {% if mismatchNote %}
        <p class="govuk-body-s" data-testid="accept-mismatch-note">
          {{ mismatchNote }}
        </p>
      {% endif %}

      <form
        method="post"
        action="{{ action }}"
        novalidate
        data-testid="accept-form"
      >
        <div class="govuk-button-group">
          {{
            govukButton({
              text: labels.confirmAction,
              attributes: { "data-testid": "accept-confirm" }
            })
          }}
          <a
            class="govuk-link"
            href="{{ cancelHref }}"
            data-testid="accept-cancel"
            >{{ labels.cancelAction }}</a
          >
        </div>
      </form>
    </div>
  </div>
{% endblock %}
