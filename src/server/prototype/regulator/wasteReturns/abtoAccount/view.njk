{% extends 'layouts/page.njk' %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "prototypeRegulatorWasteReturns/macros.njk" import sectionTabs, factsPanel %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl" data-testid="abto-account-heading">
        {{ heading }}
      </h1>

      {{ factsPanel(facts, "abto-account-facts") }}

      {{ sectionTabs(tabs) }}

      <h2 class="govuk-heading-m">{{ labels.summaryHeading }}</h2>

      {%- set rows = [] -%}
      {%- for row in summaryRows -%}
        {%- set rows = (rows.push({ key: { text: row.label }, value: { text: row.text } }), rows) -%}
      {%- endfor -%}
      {{
        govukSummaryList({
          rows: rows,
          classes: "govuk-summary-list--no-border",
          attributes: { "data-testid": "abto-account-summary" }
        })
      }}

      {% if showThresholdWarning %}
        <div
          class="app-check-card"
          data-testid="abto-account-threshold-warning"
        >
          <p
            class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1"
          >
            {{ labels.thresholdWarningHeading }}
          </p>
          <p class="govuk-body-s">{{ thresholdWarningBody }}</p>
          {{
            govukButton({
              text: labels.reviewAction,
              href: reviewHref,
              attributes: { "data-testid": "abto-account-review-classification" }
            })
          }}
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
