{% extends 'layouts/page.njk' %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% set bannerHtml %}
        <h1 class="govuk-notification-banner__heading">{{ heading }}</h1>
        <p class="govuk-body">{{ labels.body }}</p>
      {% endset %}
      {{
        govukNotificationBanner({
          type: "success",
          titleText: labels.bannerTitle,
          html: bannerHtml,
          attributes: { "data-testid": "abto-payment-received-banner" }
        })
      }}

      {{
        govukSummaryList({
          rows: [
            { key: { text: labels.amountLabel }, value: { text: amountPaid } },
            { key: { text: labels.methodLabel }, value: { text: method } },
            { key: { text: labels.referenceLabel }, value: { text: reference } },
            { key: { text: labels.paidLabel }, value: { text: paidOn } }
          ],
          attributes: { "data-testid": "abto-payment-received-summary" }
        })
      }}

      {{
        govukButton({
          text: labels.action,
          href: returnsHref,
          classes: "govuk-button--secondary",
          attributes: { "data-testid": "abto-payment-received-return" }
        })
      }}
    </div>
  </div>
{% endblock %}
