{% extends 'layouts/page.njk' %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "prototypeAbto/_totals-table.njk" import abtoTotalsTable %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      {% set bannerHtml %}
        <h3 class="govuk-notification-banner__heading">
          {{ labels.banner.heading }}
        </h3>
        <p class="govuk-body">{{ bannerText }}</p>
      {% endset %}
      {{
        govukNotificationBanner({
          titleText: labels.banner.title,
          html: bannerHtml,
          attributes: { "data-testid": "abto-threshold-banner" }
        })
      }}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-m">{{ labels.totalsHeading }}</h2>
      {{ abtoTotalsTable(totalsRows, totalsColumns, "abto-totals-table") }}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body" data-testid="abto-threshold-explanation">
        {{ explanation }}
      </p>

      <p class="govuk-heading-m" data-testid="abto-threshold-balance">
        {{ balanceDue }}
      </p>

      {{
        govukButton({
          text: labels.payAction,
          href: payHref,
          attributes: { "data-testid": "abto-threshold-pay" }
        })
      }}
    </div>
  </div>
{% endblock %}
