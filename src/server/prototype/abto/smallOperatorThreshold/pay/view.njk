{% extends 'layouts/page.njk' %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if error %}
        {{
          govukErrorSummary({
            titleText: labels.errorTitle,
            errorList: [{ text: error, href: "#paymentMethod" }],
            attributes: { "data-testid": "abto-pay-error-summary" }
          })
        }}
      {% endif %}

      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      {{
        govukSummaryList({
          rows: [
            { key: { text: labels.reasonLabel }, value: { text: labels.reason } },
            { key: { text: labels.amountLabel }, value: { text: amountDue } },
            { key: { text: labels.payByLabel }, value: { text: payBy } }
          ],
          attributes: { "data-testid": "abto-pay-summary" }
        })
      }}

      <form method="post" novalidate data-testid="abto-pay-form">
        {% set radioItems = [] %}
        {% for method in methods %}
          {% set radioItems = (radioItems.push({ value: method.value, text: method.text }), radioItems) %}
        {% endfor %}

        {{
          govukRadios({
            idPrefix: "paymentMethod",
            name: "paymentMethod",
            fieldset: {
              legend: {
                text: labels.methodHeading,
                classes: "govuk-fieldset__legend--m",
                isPageHeading: false
              }
            },
            errorMessage: { text: error } if error,
            items: radioItems
          })
        }}

        {{
          govukButton({
            text: labels.action,
            preventDoubleClick: true,
            attributes: { "data-testid": "abto-pay-continue" }
          })
        }}
      </form>
    </div>
  </div>
{% endblock %}
