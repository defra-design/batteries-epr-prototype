{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ heading }}</h1>
      <p class="govuk-body-l">{{ intro }}</p>
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full" data-testid="prototype-journeys">
      {% for group in personaGroups %}
        <h2 class="govuk-heading-l" data-testid="prototype-persona-heading-{{ group.persona }}">{{ group.heading }}</h2>

        {% for journey in group.journeys %}
          <div class="govuk-summary-card" data-testid="prototype-journey-{{ journey.id }}">
            <div class="govuk-summary-card__title-wrapper">
              <h3 class="govuk-summary-card__title">{{ journey.title }}</h3>
            </div>
            <div class="govuk-summary-card__content">
              <p class="govuk-body">{{ journey.description }}</p>
              {% if journey.codedHref or journey.figmaHref %}
                {% if journey.codedHref %}
                  {{ govukButton({
                    text: links.coded,
                    href: journey.codedHref,
                    isStartButton: true,
                    attributes: { "data-testid": "prototype-journey-" + journey.id + "-coded-cta" }
                  }) }}
                {% endif %}
                {% if journey.figmaHref %}
                  {{ govukButton({
                    text: links.figma + " (opens in new tab)",
                    href: journey.figmaHref,
                    isStartButton: true,
                    attributes: {
                      "data-testid": "prototype-journey-" + journey.id + "-figma-cta",
                      "target": "_blank",
                      "rel": "noopener noreferrer"
                    }
                  }) }}
                {% endif %}
              {% else %}
                <p data-testid="prototype-journey-{{ journey.id }}-coming-soon">
                  {{ govukTag({ text: "Coming soon", classes: "govuk-tag--blue" }) }}
                </p>
              {% endif %}
            </div>
          </div>
        {% else %}
          <p class="govuk-body" data-testid="prototype-persona-group-{{ group.persona }}-empty">No prototypes yet for this group.</p>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  <p class="govuk-body">
    <a class="govuk-link" href="{{ homeUrl }}" data-testid="prototype-home-link">{{ backLinkText }}</a>
  </p>
{% endblock %}
