{% extends 'layouts/page.njk' %}

{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ heading }}</h1>
      <p class="govuk-body-l">{{ intro }}</p>
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full" data-testid="prototype-journeys">
      {%- set tabItems = [] -%}
      {%- for group in personaGroups -%}
        {%- set panelHtml -%}
          {% for journey in group.journeys %}
            <div class="govuk-summary-card" data-testid="prototype-journey-{{ journey.id }}">
              <div class="govuk-summary-card__title-wrapper">
                <h3 class="govuk-summary-card__title">{{ journey.title }}</h3>
              </div>
              <div class="govuk-summary-card__content">
                <p class="govuk-body">{{ journey.description }}</p>
                {% if journey.codedHref or journey.figmaHref %}
                  {% if journey.codedHref %}
                    <p class="govuk-body">
                      <a class="govuk-link" href="{{ journey.codedHref }}" data-testid="prototype-journey-{{ journey.id }}-coded-cta">{{ links.coded }}<span class="govuk-visually-hidden"> – {{ journey.title }}</span></a>
                    </p>
                  {% endif %}
                  {% if journey.figmaHref %}
                    <p class="govuk-body">
                      <a class="govuk-link" href="{{ journey.figmaHref }}" target="_blank" rel="noopener noreferrer" data-testid="prototype-journey-{{ journey.id }}-figma-cta">{{ links.figma }}<span class="govuk-visually-hidden"> – {{ journey.title }} (opens in new tab)</span></a>
                    </p>
                  {% endif %}
                {% else %}
                  <p data-testid="prototype-journey-{{ journey.id }}-coming-soon">
                    {{ govukTag({ text: "Coming soon", classes: "govuk-tag--blue" }) }}
                  </p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {%- endset -%}
        {%- set tabItems = (tabItems.push({
          label: group.heading,
          id: "persona-" + group.persona,
          panel: { html: panelHtml },
          attributes: { "data-testid": "prototype-tab-" + group.persona }
        }), tabItems) -%}
      {%- endfor -%}

      {{ govukTabs({
        items: tabItems
      }) }}
    </div>
  </div>

  <p class="govuk-body">
    <a class="govuk-link" href="{{ homeUrl }}" data-testid="prototype-home-link">{{ backLinkText }}</a>
  </p>
{% endblock %}
