{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block pageTitle %}{{ pageTitle }}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary and errorSummary.length %}
        {{
          govukErrorSummary({
            titleText: labels.error.title,
            errorList: errorSummary,
            attributes: { "data-testid": "query-response-sign-in-error-summary" }
          })
        }}
      {% endif %}

      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <form
        method="post"
        action="{{ action }}"
        novalidate
        data-testid="query-response-sign-in-form"
      >
        {{
          govukInput({
            id: "email",
            name: "email",
            type: "email",
            autocomplete: "email",
            spellcheck: false,
            value: values.email,
            label: { text: labels.emailLabel },
            hint: { text: labels.emailHint },
            errorMessage: { text: errors.email } if errors.email,
            classes: "govuk-!-width-two-thirds",
            attributes: { "data-testid": "query-response-sign-in-email" }
          })
        }}

        {{
          govukInput({
            id: "password",
            name: "password",
            type: "password",
            autocomplete: "current-password",
            label: { text: labels.passwordLabel },
            errorMessage: { text: errors.password } if errors.password,
            classes: "govuk-!-width-two-thirds",
            attributes: { "data-testid": "query-response-sign-in-password" }
          })
        }}

        <p class="govuk-body govuk-!-margin-bottom-1">
          <a
            class="govuk-link"
            href="#"
            data-testid="query-response-sign-in-forgot-email"
            >{{ labels.forgotEmailLink }}</a
          >
        </p>
        <p class="govuk-body">
          <a
            class="govuk-link"
            href="#"
            data-testid="query-response-sign-in-forgot-password"
            >{{ labels.forgotPasswordLink }}</a
          >
        </p>

        {{
          govukButton({
            text: labels.signInAction,
            attributes: { "data-testid": "query-response-sign-in-submit" }
          })
        }}
      </form>

      <p class="govuk-body">
        <a
          class="govuk-link"
          href="#"
          data-testid="query-response-sign-in-create"
          >{{ labels.createLink }}</a
        >
      </p>
    </div>
  </div>
{% endblock %}
