{% extends 'layouts/page.njk' %}

{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <p class="govuk-body">{{ labels.body }}</p>

      {{ govukWarningText({
        text: labels.warning,
        iconFallbackText: "Warning"
      }) }}

      <h2 class="govuk-heading-m">{{ labels.whyHeading }}</h2>
      <p class="govuk-body">{{ labels.whyBody }}</p>

      <h2 class="govuk-heading-m">{{ labels.insteadHeading }}</h2>
      <ul class="govuk-list govuk-list--bullet">
        {% for bullet in labels.insteadBullets %}
          <li>{{ bullet }}</li>
        {% endfor %}
      </ul>

      <p class="govuk-body">{{ labels.contactBody }}</p>

      <p class="govuk-body">
        <a class="govuk-link" href="#" data-testid="overseas-exit-contact-support">{{ labels.contactLink }}</a>
      </p>

      <p class="govuk-body">
        <a class="govuk-link" href="{{ changeAnswerUrl }}" data-testid="overseas-exit-change-answer">{{ labels.changeAnswerLink }}</a>
      </p>
    </div>
  </div>
{% endblock %}
