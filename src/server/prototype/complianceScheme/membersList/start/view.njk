{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      <p class="govuk-body">{{ labels.intro }}</p>

      {{ govukInsetText({
        text: labels.insetText,
        attributes: { "data-testid": "members-list-start-inset-text" }
      }) }}

      <h2 class="govuk-heading-m">{{ labels.beforeYouStartHeading }}</h2>
      <p class="govuk-body">{{ labels.checkIntro }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for bullet in labels.checkBullets %}
          <li>{{ bullet }}</li>
        {% endfor %}
      </ul>

      <p class="govuk-body">{{ labels.needIntro }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for bullet in labels.needBullets %}
          <li>{{ bullet }}</li>
        {% endfor %}
      </ul>

      <h2 class="govuk-heading-m">{{ labels.applyHeading }}</h2>
      {{ govukButton({
        text: labels.startAction,
        href: startUrl,
        isStartButton: true,
        attributes: { "data-testid": "members-list-start-button" }
      }) }}

      <h2 class="govuk-heading-s">{{ labels.helpHeading }}</h2>
      <p class="govuk-body">
        {{ labels.helpBody }}<br>
        {{ labels.helpPhone }}<br>
        {{ labels.helpEmailLabel }} <a class="govuk-link" href="#" data-testid="members-list-start-help-email">{{ labels.helpEmail }}</a>
      </p>
    </div>

    <div class="govuk-grid-column-one-third">
      <aside class="app-related-content" data-testid="members-list-start-related-content">
        <h2 class="govuk-heading-s">{{ labels.relatedHeading }}</h2>
        <ul class="govuk-list govuk-body-s">
          {% for link in labels.relatedLinks %}
            <li><a class="govuk-link" href="#">{{ link }}</a></li>
          {% endfor %}
        </ul>

        <h2 class="govuk-heading-s">{{ labels.guidanceHeading }}</h2>
        <ul class="govuk-list govuk-body-s">
          {% for link in labels.guidanceLinks %}
            <li><a class="govuk-link" href="#">{{ link }}</a></li>
          {% endfor %}
        </ul>
      </aside>
    </div>
  </div>
{% endblock %}
