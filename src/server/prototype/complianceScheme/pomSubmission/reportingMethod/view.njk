{% extends 'layouts/page.njk' %}

{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary and errorSummary.length %}
        {{ govukErrorSummary({
          titleText: errorTitle,
          errorList: errorSummary,
          attributes: { "data-testid": "reporting-method-error-summary" }
        }) }}
      {% endif %}

      <span class="govuk-caption-l" data-testid="reporting-method-caption">{{ caption }}</span>
      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      <p class="govuk-body">
        {{ labels.guidanceIntro }}
        <a class="govuk-link" href="#" data-testid="reporting-method-guidance-link">{{ labels.guidanceLink }}</a>.
      </p>

      <form method="post" action="{{ action }}" novalidate data-testid="reporting-method-form">
        {{ govukRadios({
          idPrefix: "reportingMethod",
          name: "reportingMethod",
          errorMessage: { text: errors.reportingMethod } if errors.reportingMethod,
          items: [
            {
              value: "single",
              text: labels.singleMemberLabel,
              hint: { text: labels.singleMemberHint },
              checked: formValues.reportingMethod == "single",
              attributes: { "data-testid": "reporting-method-single" }
            },
            {
              value: "bulk",
              text: labels.bulkUploadLabel,
              hint: { text: labels.bulkUploadHint },
              checked: formValues.reportingMethod == "bulk",
              attributes: { "data-testid": "reporting-method-bulk" }
            }
          ]
        }) }}

        {{ govukButton({
          text: labels.continueAction,
          attributes: { "data-testid": "reporting-method-continue" }
        }) }}
      </form>
    </div>
  </div>

  <script type="application/json" id="page-payload" data-testid="page-payload">{{ pagePayload | dump | safe }}</script>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  <script type="module" src="{{ getAssetPath('prototypeComplianceScheme.js') }}"></script>
{% endblock %}
