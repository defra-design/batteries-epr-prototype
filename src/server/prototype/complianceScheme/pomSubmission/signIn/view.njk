{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block pageTitle %}{{ pageTitle }}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <form method="post" action="{{ action }}" novalidate data-testid="compliance-scheme-sign-in-form">
        {{ govukInput({
          id: "email",
          name: "email",
          type: "email",
          autocomplete: "email",
          label: { text: labels.emailLabel },
          classes: "govuk-!-width-two-thirds",
          attributes: { "data-testid": "compliance-scheme-sign-in-email" }
        }) }}

        {{ govukInput({
          id: "password",
          name: "password",
          type: "password",
          label: { text: labels.passwordLabel },
          classes: "govuk-!-width-two-thirds",
          attributes: { "data-testid": "compliance-scheme-sign-in-password" }
        }) }}

        <p class="govuk-body govuk-!-margin-bottom-1">
          <a class="govuk-link" href="#" data-testid="compliance-scheme-sign-in-forgot-email">{{ labels.forgotEmailLink }}</a>
        </p>
        <p class="govuk-body">
          <a class="govuk-link" href="#" data-testid="compliance-scheme-sign-in-forgot-password">{{ labels.forgotPasswordLink }}</a>
        </p>

        {{ govukButton({
          text: labels.signInAction,
          attributes: { "data-testid": "compliance-scheme-sign-in-submit" }
        }) }}
      </form>

      <p class="govuk-body">
        <a class="govuk-link" href="#" data-testid="compliance-scheme-sign-in-create">{{ labels.createLink }}</a>
      </p>
    </div>
  </div>
{% endblock %}
