{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l" data-testid="upload-success-caption">{{ caption }}</span>
      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      <p class="govuk-body govuk-!-font-weight-bold" data-testid="upload-success-reference">{{ referenceLine }}</p>

      {% set rows = [] %}
      {% for row in summaryRows %}
        {% set rows = (rows.push({ key: { text: row.key }, value: { text: row.value } }), rows) %}
      {% endfor %}

      {{ govukSummaryList({
        rows: rows,
        attributes: { "data-testid": "upload-success-summary" }
      }) }}

      <h2 class="govuk-heading-m">{{ labels.nextHeading }}</h2>
      <p class="govuk-body">{{ labels.nextBody }}</p>

      <p class="govuk-body">
        <a class="govuk-link" href="#" data-testid="upload-success-receipt">{{ labels.downloadReceiptLink }}</a>
      </p>
      <p class="govuk-body">
        <a class="govuk-link" href="#" data-testid="upload-success-history">{{ labels.viewHistoryLink }}</a>
      </p>

      <p class="govuk-body">{{ labels.evidenceNote }}</p>

      {{ govukButton({
        text: labels.continueAction,
        href: "#",
        attributes: { "data-testid": "upload-success-continue" }
      }) }}
    </div>
  </div>
{% endblock %}
