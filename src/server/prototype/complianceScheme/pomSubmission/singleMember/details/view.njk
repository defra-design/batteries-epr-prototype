{% extends 'layouts/page.njk' %}

{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary and errorSummary.length %}
        {{ govukErrorSummary({
          titleText: errorTitle,
          errorList: errorSummary,
          attributes: { "data-testid": "single-member-details-error-summary" }
        }) }}
      {% endif %}

      <span class="govuk-caption-l" data-testid="single-member-details-caption">{{ caption }}</span>
      <p class="govuk-body govuk-!-margin-bottom-2" data-testid="single-member-details-step">{{ labels.stepLabel }}</p>
      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      <form method="post" action="{{ action }}" novalidate data-testid="single-member-details-form">
        {{ govukSelect({
          id: "memberId",
          name: "memberId",
          label: { text: labels.memberLabel, classes: "govuk-label--m" },
          items: memberItems,
          errorMessage: { text: errors.memberId } if errors.memberId,
          attributes: { "data-testid": "single-member-details-member" }
        }) }}

        {{ govukInput({
          id: "bprn",
          name: "bprn",
          label: { text: labels.bprnLabel, classes: "govuk-label--m" },
          hint: { text: labels.bprnHint },
          value: bprn,
          classes: "govuk-input--width-10",
          attributes: { readonly: "readonly", "data-testid": "single-member-details-bprn" }
        }) }}

        {{ govukInput({
          id: "schemeRef",
          name: "schemeRef",
          label: { text: labels.schemeRefLabel, classes: "govuk-label--m" },
          hint: { text: labels.schemeRefHint },
          value: schemeRef,
          classes: "govuk-input--width-10",
          attributes: { readonly: "readonly", "data-testid": "single-member-details-scheme-ref" }
        }) }}

        {{ govukButton({
          text: labels.continueAction,
          attributes: { "data-testid": "single-member-details-continue" }
        }) }}
      </form>
    </div>
  </div>

  <script type="application/json" id="page-payload" data-testid="page-payload">{{ pagePayload | dump | safe }}</script>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  <script type="module" src="{{ getAssetPath('prototypeComplianceScheme.js') }}"></script>
{% endblock %}
