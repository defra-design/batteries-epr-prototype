{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-panel govuk-panel--confirmation" data-testid="payment-confirmed-panel">
        <h1 class="govuk-panel__title">{{ heading }}</h1>
        <div class="govuk-panel__body">
          {{ labels.panelBodyPrefix }}
          <br>
          <strong data-testid="payment-confirmed-reference"></strong>
        </div>
      </div>

      <p class="govuk-body">{{ labels.receivedBody }}</p>

      <h2 class="govuk-heading-m">{{ labels.whatNextHeading }}</h2>
      <p class="govuk-body">{{ labels.whatNextBody }}</p>

      <p class="govuk-body">
        <a class="govuk-link" href="{{ accountUrl }}" data-testid="payment-confirmed-return">{{ labels.returnLink }}</a>
      </p>

      <p class="govuk-body-s">{{ labels.feedbackNote }}</p>
    </div>
  </div>

  <script type="application/json" id="page-payload" data-testid="page-payload">{{ pagePayload | dump | safe }}</script>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  <script type="module" src="{{ getAssetPath('prototypeSubmission.js') }}"></script>
{% endblock %}
